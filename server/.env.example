NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# MongoDB. Local mongod by default; an Atlas URI works unchanged.
MONGO_URI=mongodb://127.0.0.1:27017/subsidence

# Comma-separated origins allowed to call the API (the Vite dev server proxies, so this is
# only needed when the client is served from another origin).
CORS_ORIGINS=http://localhost:5173

# Auth. Use long random strings (e.g. `node -e "console.log(crypto.randomBytes(48).toString('hex'))"`).
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7

# Demo user created by `npm run seed` (email demo@site01.local). Minimum 10 characters.
DEMO_PASSWORD=change-me-demo-pass

# Key the real gateway sends as x-api-key to POST /api/ingest/frames.
INGEST_API_KEY=change-me-ingest-key

# Default site shown by the dashboard.
DEFAULT_SITE_ID=site-01

# Simulator: replays the dummy scenarios as live data after the 7-day history.
SIMULATOR=on
# 60 = one real second is one simulated minute (a 10-minute reading every 10 s).
SIM_SPEED=60
# Extra simulated minutes to skip at start (0 = continue straight after the history).
SIM_START_OFFSET_MIN=0

# Prediction model. The same code path serves the mock and the real server.
MODEL_MODE=mock
MODEL_URL=http://localhost:8001
MODEL_API_KEY=
MODEL_TIMEOUT_MS=5000
MODEL_RETRIES=2
MODEL_MIN_INTERVAL_MIN=5

# Mock model app
MOCK_MODEL_PORT=8001
MOCK_MODEL_FAIL_RATE=0.02

# Retention of pipeline outputs, in days (predictions and zone history).
RETENTION_DAYS=30

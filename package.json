{
  "name": "subsidence-dashboard",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n mongo,server,model,client -c gray,cyan,yellow,green \"node scripts/mongo.js\" \"npm run dev -w server\" \"npm run model -w server\" \"npm run dev -w client\"",
    "mongo": "node scripts/mongo.js",
    "generate:data": "npm run generate:data -w server",
    "seed": "npm run seed -w server",
    "user:create": "npm run user:create -w server --",
    "test": "npm test -w shared && npm test -w server && npm test -w client",
    "e2e": "npm run e2e -w client",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "concurrently": "^9.1.0",
    "eslint": "^9.14.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.12.0",
    "prettier": "^3.3.3",
    "dotenv": "^16.4.5",
    "mongodb-memory-server-core": "^10.1.2"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true,
    "esbuild@0.21.5": true,
    "mongodb-memory-server@10.4.3": true
  }
}

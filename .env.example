# Root settings used only by scripts/mongo.js (the local MongoDB launcher in `npm run dev`).
# The server's own settings live in server/.env (copy server/.env.example).

# auto: use MONGO_URI from server/.env if reachable, otherwise start a local mongod
# off:  never start one (e.g. when using Docker or Atlas)
MONGO_LOCAL=auto
MONGO_LOCAL_VERSION=7.0.14
MONGO_LOCAL_DBPATH=.data/mongo
